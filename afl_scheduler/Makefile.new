# AFL++ CPU Scheduler Makefile with Parameterized Components

# Compiler and flags
CC = gcc
CFLAGS = -Wall -Werror -O2
LDFLAGS = -lbpf -lelf -lm

# BPF compiler
CLANG ?= clang
LLVM_STRIP ?= llvm-strip
BPFTOOL ?= bpftool

# SCX path - adjust this to point to your SCX installation
SCX_PATH ?= ../scx

# Source files
MONITOR_SRC = afl_monitor.c
MONITOR_DIRECT_SRC = afl_monitor_direct.c
MONITOR_PARAM_SRC = afl_monitor_param.c
SCHED_SRC = afl_sched.c
SCHED_LOADER_SRC = afl_sched_loader.c
SCHED_LOADER_PARAM_SRC = afl_sched_loader_param.c
STATS_COLLECTOR_SRC = stats_collector.c
BPF_SRC = bpf/afl_sched.bpf.c
BPF_PARAM_SRC = bpf/afl_sched_param.bpf.c

# Output files
MONITOR_BIN = afl_monitor
MONITOR_DIRECT_BIN = afl_monitor_direct
MONITOR_PARAM_BIN = afl_monitor_param
SCHED_BIN = afl_sched
SCHED_LOADER_BIN = afl_sched_loader
SCHED_LOADER_PARAM_BIN = afl_sched_loader_param
STATS_COLLECTOR_BIN = stats_collector
BPF_OBJ = bpf/afl_sched.bpf.o
BPF_PARAM_OBJ = bpf/afl_sched_param.bpf.o
SKEL_H = afl_sched.skel.h
SKEL_PARAM_H = afl_sched_param.skel.h

# Default target
all: $(MONITOR_BIN) $(SCHED_BIN) $(STATS_COLLECTOR_BIN)

# Direct BPF map access version
direct: $(MONITOR_DIRECT_BIN) $(SCHED_LOADER_BIN) $(STATS_COLLECTOR_BIN)

# Parameterized version
param: $(MONITOR_PARAM_BIN) $(SCHED_LOADER_PARAM_BIN) $(STATS_COLLECTOR_BIN)

# Build monitor daemon
$(MONITOR_BIN): $(MONITOR_SRC)
$(CC) $(CFLAGS) -o $@ $< -lm

# Build direct monitor daemon
$(MONITOR_DIRECT_BIN): $(MONITOR_DIRECT_SRC)
$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Build parameterized monitor daemon
$(MONITOR_PARAM_BIN): $(MONITOR_PARAM_SRC)
$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Build scheduler
$(SCHED_BIN): $(SCHED_SRC) $(SKEL_H)
$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Build scheduler loader
$(SCHED_LOADER_BIN): $(SCHED_LOADER_SRC) $(SKEL_H)
$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Build parameterized scheduler loader
$(SCHED_LOADER_PARAM_BIN): $(SCHED_LOADER_PARAM_SRC) $(SKEL_PARAM_H)
$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Build stats collector
$(STATS_COLLECTOR_BIN): $(STATS_COLLECTOR_SRC)
$(CC) $(CFLAGS) -o $@ $<

# Generate BPF skeleton
$(SKEL_H): $(BPF_OBJ)
$(BPFTOOL) gen skeleton $< > $@

# Generate parameterized BPF skeleton
$(SKEL_PARAM_H): $(BPF_PARAM_OBJ)
$(BPFTOOL) gen skeleton $< > $@

# Compile BPF program
$(BPF_OBJ): $(BPF_SRC)
$(CLANG) -g -O2 -target bpf -D__TARGET_ARCH_x86 \
clude -I$(SCX_PATH) \
G) -g -O2 -target bpf -D__TARGET_ARCH_x86 \
clude -I$(SCX_PATH) \
 up
clean:
rm -f $(MONITOR_BIN) $(MONITOR_DIRECT_BIN) $(MONITOR_PARAM_BIN) \
      $(SCHED_BIN) $(SCHED_LOADER_BIN) $(SCHED_LOADER_PARAM_BIN) \
      $(STATS_COLLECTOR_BIN) $(SKEL_H) $(SKEL_PARAM_H) \
      $(BPF_OBJ) $(BPF_PARAM_OBJ)

# Install
install: all
install -m 755 $(MONITOR_BIN) /usr/local/bin/
install -m 755 $(SCHED_BIN) /usr/local/bin/
install -m 755 afl_sched_ctl.sh /usr/local/bin/

# Install direct version
install-direct: direct
install -m 755 $(MONITOR_DIRECT_BIN) /usr/local/bin/
install -m 755 $(SCHED_LOADER_BIN) /usr/local/bin/
install -m 755 afl_sched_ctl_direct.sh /usr/local/bin/afl_sched_ctl.sh

# Install parameterized version
install-param: param
install -m 755 $(MONITOR_PARAM_BIN) /usr/local/bin/
install -m 755 $(SCHED_LOADER_PARAM_BIN) /usr/local/bin/
install -m 755 afl_sched_ctl_param.sh /usr/local/bin/afl_sched_ctl.sh

.PHONY: all direct param clean install install-direct install-param
