# AFL++ CPU Scheduler Makefile (Direct BPF Map Access Version)

# Compiler and flags
CC = gcc
CFLAGS = -Wall -Werror -O2
LDFLAGS = -lbpf -lelf

# BPF compiler
CLANG ?= clang
LLVM_STRIP ?= llvm-strip
BPFTOOL ?= bpftool

# SCX path - adjust this to point to your SCX installation
SCX_PATH ?= ../scx

# Source files
MONITOR_SRC = afl_monitor_direct.c
LOADER_SRC = afl_sched_loader.c
BPF_SRC = bpf/afl_sched.bpf.c

# Output files
MONITOR_BIN = afl_monitor_direct
LOADER_BIN = afl_sched_loader
BPF_OBJ = bpf/afl_sched.bpf.o
SKEL_H = afl_sched.skel.h

# Default target
all: direct

# Direct BPF map access version
direct: $(MONITOR_BIN) $(LOADER_BIN)

# Build monitor daemon with direct BPF map access
$(MONITOR_BIN): $(MONITOR_SRC)
	$(CC) $(CFLAGS) -o $@ $< -lbpf -lm

# Build BPF object file
$(BPF_OBJ): $(BPF_SRC)
	$(CLANG) -g -O2 -target bpf \
	-D__TARGET_ARCH_x86 \
	-I$(SCX_PATH) \
	-I$(SCX_PATH)/scheds/include \
	-c $(BPF_SRC) -o $@
	$(LLVM_STRIP) -g $@

# Generate skeleton header
$(SKEL_H): $(BPF_OBJ)
	$(BPFTOOL) gen skeleton $< > $@

# Build scheduler loader
$(LOADER_BIN): $(LOADER_SRC) $(SKEL_H)
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Clean
clean:
	rm -f $(MONITOR_BIN) $(LOADER_BIN) $(BPF_OBJ) $(SKEL_H)

# Install
install: direct
	install -m 755 $(MONITOR_BIN) /usr/local/bin/
	install -m 755 $(LOADER_BIN) /usr/local/bin/
	install -m 755 afl_sched_ctl_direct.sh /usr/local/bin/afl_sched_ctl

.PHONY: all direct clean install